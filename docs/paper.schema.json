{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Paper Watch Paper Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "source",
    "url",
    "date",
    "read_level",
    "tags",
    "summary",
    "objective",
    "methods",
    "results",
    "novelty",
    "limitations",
    "report",
    "reportDate"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(arxiv:[0-9]{4}\\.[0-9]{4,5}|pmid:[0-9]{6,9})$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "enum": [
        "arXiv",
        "PubMed"
      ]
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://(arxiv\\.org/abs/[0-9]{4}\\.[0-9]{4,5}|pubmed\\.ncbi\\.nlm\\.nih\\.gov/[0-9]{6,9}/?)$"
    },
    "date": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "read_level": {
      "enum": [
        "bibliographic",
        "abstract",
        "full_text"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "objective": {
      "type": [
        "string",
        "null"
      ]
    },
    "methods": {
      "type": [
        "string",
        "null"
      ]
    },
    "results": {
      "type": [
        "string",
        "null"
      ]
    },
    "novelty": {
      "type": [
        "string",
        "null"
      ]
    },
    "limitations": {
      "type": [
        "string",
        "null"
      ]
    },
    "report": {
      "type": "string",
      "pattern": "^reports/daily/[0-9]{4}-[0-9]{2}-[0-9]{2}.*\\.md$"
    },
    "reportDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
